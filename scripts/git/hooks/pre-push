#!/bin/sh
# Refuses to push a commit carrying agent attribution. Adapted from tearleads'
# scripts/git/hooks/pre-push, with its timing, lint and test stages dropped:
# this repository's suite runs from `bun run check`, and gating a push on the
# browser suites would cost minutes on every push.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# A copied hook must match the checked-out version before it can gate a push.
if ! cmp -s "$0" "$REPO_ROOT/scripts/git/hooks/pre-push"; then
  echo "Error: pre-push hook is stale. Run sh scripts/git/install-hooks.sh." >&2
  exit 1
fi

# The gate runs its own installed copy of the check, so editing the worktree
# cannot change what it enforces; this refuses to run when the two have
# diverged, the same contract the hook body has.
# Parameter expansion, not dirname: one less command a hook's
# environment has to carry.
CHECK="${0%/*}/check-coauthors.ts"
if ! cmp -s "$CHECK" "$REPO_ROOT/scripts/check-coauthors.ts"; then
  echo "Error: the installed attribution check is stale. Run sh scripts/git/install-hooks.sh." >&2
  exit 1
fi

cd "$REPO_ROOT"

# Git names the remote being pushed to. Captured before the loop, which reuses
# the positional parameters to build each range.
push_remote="${1:-}"

# Hooks run with the invoking process's PATH, which for a GUI client or a shell
# without mise activated does not carry bun. Falling through to "bun: not found"
# would fail closed but block every commit, so resolve it the way mise.toml
# pins it and say what to do when it cannot be found at all.
if command -v bun >/dev/null 2>&1; then
  BUN=bun
elif command -v mise >/dev/null 2>&1 && BUN="$(mise which bun 2>/dev/null)" && [ -x "$BUN" ]; then
  :
else
  echo "Error: this hook needs bun, which mise.toml pins. Run 'mise use' in the" >&2
  echo "       repository, or put mise's shims on PATH, then try again." >&2
  exit 1
fi

zero_sha="0000000000000000000000000000000000000000"
refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT
trap 'exit 1' HUP INT TERM

# Git feeds the refs being pushed on stdin. Run by hand there is no stdin to
# read, and a hook that then scanned nothing would look like a pass.
if [ -t 0 ]; then
  echo "Error: pre-push reads the refs being pushed on stdin; run it through git push." >&2
  exit 1
fi
cat >"$refs_file"

while read -r _ local_sha _ remote_sha; do
  # A deletion pushes no commit.
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$remote_sha" = "$zero_sha" ]; then
    # A branch the remote does not have yet. Subtracting local main would miss
    # what this push actually transfers: an offending commit sitting unpushed on
    # main is carried along by any branch descending from it, and pushing main
    # itself would scan nothing at all. Subtract what this remote already has
    # instead, which is exactly what the push adds.
    #
    # A push straight to a URL names no remote whose refs describe the
    # destination, so scan the whole branch. That can refuse a commit already
    # published elsewhere, which is noisy; subtracting some other remote's refs
    # instead would let one through, which is the failure that matters.
    if [ -n "$push_remote" ] && git config --get "remote.$push_remote.url" >/dev/null 2>&1; then
      set -- "$local_sha" --not "--remotes=$push_remote"
    else
      set -- "$local_sha"
    fi
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    set -- "$remote_sha..$local_sha"
  else
    # Git can advertise a tip this clone has never fetched — a narrow refspec,
    # or a push to another remote's branch. Asking git log for it would die on
    # the unknown object and block a clean push for an unrelated reason.
    #
    # Scan the whole branch. Subtracting --remotes here would exclude commits
    # that sit on some other remote but not on this destination, which is an
    # under-scan: the same mistake as subtracting them for a push to a URL.
    # Refusing a commit already published elsewhere is noise; letting one
    # through is the failure that matters.
    set -- "$local_sha"
  fi

  "$BUN" "$CHECK" --range "$@" </dev/null
done <"$refs_file"
