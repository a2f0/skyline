{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 72
  },
  "merge": {
    "requireChecks": false,
    "requiredChecks": []
  },
  "review": {
    "timeoutMs": 1200000
  },
  "versions": {
    "packages": [
      "."
    ]
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "branch": {
    "maxLength": null,
    "exempt": [
      "main",
      "master"
    ]
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": true,
    "rejectCoauthors": false,
    "rejectClaudeAttribution": false,
    "subjects": false
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      },
      {
        "source": "scripts/checks/check-coauthors.ts",
        "target": "check-coauthors.ts",
        "executable": false
      },
      {
        "source": "agent-tool.json",
        "target": "agent-tool.json",
        "executable": false
      }
    ]
  },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          { "path": "favicon.svg", "layers": [{ "source": "logo" }] },
          { "path": "favicon.ico", "sizes": [16, 32, 48], "layers": [{ "source": "logo" }] },
          { "path": "apple-touch-icon.png", "size": 180, "opaque": true, "layers": [{ "fill": "#000000" }, { "source": "logo", "scale": 0.8 }] }
        ]
      }
    }
  }
}
